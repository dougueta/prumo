{
  "name": "prumo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:setup": "node scripts/dev-setup.mjs",
    "dev:demo": "node scripts/start-demo.mjs 3000 --dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test:unit",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "next build && playwright test",
    "synthetic": "tsx scripts/synthetic.ts",
    "review:gate": "tsx scripts/review/gate.ts",
    "review:main-guard": "tsx scripts/review/main-guard.ts",
    "review:bundle": "tsx scripts/review/bundle.ts",
    "review:publish": "tsx scripts/review/publish.ts",
    "review:mirror": "tsx scripts/review/mirror.ts",
    "pr:merge": "tsx scripts/review/merge.ts",
    "gh:labels": "tsx scripts/review/labels.ts",
    "gh:repo-settings": "tsx scripts/review/repo-settings.ts",
    "gh:ruleset": "tsx scripts/review/ruleset.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.1.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "fast-xml-parser": "5.11.2",
    "jsdom": "29.1.1",
    "prettier": "3.9.9",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": ">=24"
  }
}
